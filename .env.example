# ============================================================
# WorkLingo — mẫu biến môi trường (CHỈ secret bootstrap)
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# Mọi cấu hình hệ thống khác nằm trong bảng app_settings (DB).
# ============================================================

# --- PostgreSQL (Docker, xem docker-compose.yml) ---
POSTGRES_USER=worklingo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=worklingo
POSTGRES_PORT=5432

# Connection string Drizzle + postgres.js dùng để kết nối DB.
DATABASE_URL=postgresql://worklingo:changeme@localhost:5432/worklingo

# --- Auth.js (NextAuth) ---
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# Bật đăng nhập dev tạm (CHỈ dev, Phase 5 gỡ)
AUTH_DEV_LOGIN="false"

# Endpoint OpenAI-compatible (để trống nếu dùng OpenAI chính thức)
OPENAI_BASE_URL=""

# SMTP cho email đặt lại mật khẩu (để trống = log ra console ở dev)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
