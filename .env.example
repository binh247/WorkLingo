# ============================================================
# WorkLingo — mẫu biến môi trường (CHỈ secret bootstrap).
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# Mọi cấu hình khác (OpenAI, SMTP, model, ...) nằm trong bảng
# app_settings (DB), sửa qua trang Quản trị /admin.
# ============================================================

# --- PostgreSQL (Docker, xem docker-compose.yml) ---
POSTGRES_USER=worklingo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=worklingo
POSTGRES_PORT=5432

# Connection string Drizzle + postgres.js dùng để kết nối DB.
DATABASE_URL=postgresql://worklingo:changeme@localhost:5432/worklingo

# --- Auth.js (NextAuth) — bắt buộc ở env vì đọc TRƯỚC khi nối DB ---
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# --- Google OAuth (tuỳ chọn; Auth.js đọc từ env lúc khởi động) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
